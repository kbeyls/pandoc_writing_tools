digraph FeatureDemo {
  graph [
    bgcolor="transparent"
    pad="0.2"
    rankdir="LR"
  ]
  node [
    color="#3d5a80"
    fillcolor="#e7eef8"
    fontname="Helvetica"
    shape="box"
    style="rounded,filled"
  ]
  edge [
    color="#3d5a80"
  ]

  source [label="Graphviz DOT source"]
  renderer [label="Make + Graphviz", fillcolor="#f7d6bf", color="#c65d28"]
  svg [label="SVG for HTML"]
  pdf [label="PDF for LaTeX"]
  png [label="PNG for Office\nand Confluence"]

  source -> renderer
  renderer -> {svg pdf png}
}
